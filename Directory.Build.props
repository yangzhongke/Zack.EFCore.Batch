        <EfCoreSqliteVersion_Net90>9.0.0</EfCoreSqliteVersion_Net90>
        <EfCoreSqliteVersion_Net100>10.0.0</EfCoreSqliteVersion_Net100>

        <EfCoreSqlServerVersion_Net50>[5.0.0,6.0.0)</EfCoreSqlServerVersion_Net50>
        <EfCoreSqlServerVersion_Net60>6.0.0</EfCoreSqlServerVersion_Net60>
        <EfCoreSqlServerVersion_Net70>7.0.0</EfCoreSqlServerVersion_Net70>
        <EfCoreSqlServerVersion_Net80>8.0.0</EfCoreSqlServerVersion_Net80>
        <EfCoreSqlServerVersion_Net90>9.0.0</EfCoreSqlServerVersion_Net90>
        <EfCoreSqlServerVersion_Net100>10.0.0</EfCoreSqlServerVersion_Net100>

        <EfCoreNpgsqlVersion_Net50>[5.0.0,6.0.0)</EfCoreNpgsqlVersion_Net50>
