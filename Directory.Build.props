<Project>
    <PropertyGroup>
        <LangVersion>10</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <Authors>Zack Yang(杨中科)</Authors>
        <RepositoryUrl>https://github.com/yangzhongke/Zack.EFCore.Batch</RepositoryUrl>
        <PackageProjectUrl>https://github.com/yangzhongke/Zack.EFCore.Batch</PackageProjectUrl>

        <!-- EF Core / provider versions centralized for multi-target packaging -->
        <EfCoreRelationalVersion_Net50>[5.0.5,6.0.0)</EfCoreRelationalVersion_Net50>
        <EfCoreRelationalVersion_Net60>6.0.11</EfCoreRelationalVersion_Net60>
        <EfCoreRelationalVersion_Net70>7.0.0</EfCoreRelationalVersion_Net70>
        <EfCoreRelationalVersion_Net80>8.0.0</EfCoreRelationalVersion_Net80>
        <EfCoreRelationalVersion_Net90>9.0.0</EfCoreRelationalVersion_Net90>
        <EfCoreRelationalVersion_Net100>10.0.0</EfCoreRelationalVersion_Net100>

        <EfCoreInMemoryVersion_Net50>5.0.0</EfCoreInMemoryVersion_Net50>
