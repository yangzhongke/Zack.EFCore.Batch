<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net5.0;net6.0;net7.0;net8.0;net9.0</TargetFrameworks>
        <PackageId>Zack.EFCore.BatchInsert.MySQL.Pomelo</PackageId>
        <Version>1.0.0</Version>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <Description>A MySQL (Pomelo)-specific package for Zack.EFCore.BatchInsert. Supports EF Core 5, 6, 7, 8 and 9.</Description>
    </PropertyGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net5.0'">
        <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" Version="$(EfCorePomeloVersion_Net50)"/>
    </ItemGroup>
    <ItemGroup Condition="'$(TargetFramework)' == 'net6.0'">
        <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" Version="$(EfCorePomeloVersion_Net60)"/>
    </ItemGroup>
    <ItemGroup Condition="'$(TargetFramework)' == 'net7.0'">
        <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" Version="$(EfCorePomeloVersion_Net70)"/>
    </ItemGroup>
    <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
        <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" Version="$(EfCorePomeloVersion_Net80)"/>
    </ItemGroup>
    <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
        <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" Version="$(EfCorePomeloVersion_Net90)"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Zack.EFCore.BatchInsert\Zack.EFCore.BatchInsert.csproj"/>
    </ItemGroup>

</Project>